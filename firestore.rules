rules_version = '2';

// Firebase 콘솔 → Firestore → 규칙에 그대로 붙여 넣어요.
service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() {
      return request.auth.token.email.lower();
    }
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // admins/{이메일} 문서가 있으면 관리자
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }

    function validPost() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'category', 'date', 'body', 'links', 'pinned',
                               'speaker', 'affiliation', 'time', 'place', 'updatedAt', 'updatedBy'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.body is string && d.body.size() <= 50000
        && d.pinned is bool
        && d.links is list && d.links.size() <= 10;
    }

    function text(v, max) {
      return v is string && v.size() <= max;
    }
    function validMember() {
      let d = request.resource.data;
      let photo = d.get('photo', '');
      return d.keys().hasOnly(['nameKo', 'nameEn', 'role', 'positionKo', 'positionEn', 'deptKo', 'deptEn',
                               'researchKo', 'researchEn', 'email', 'photo', 'updatedAt', 'updatedBy'])
        && d.nameKo is string && d.nameKo.size() > 0 && d.nameKo.size() <= 50
        && d.role in ['fulltime', 'postdoc', 'researcher', 'student', 'staff']
        && text(d.get('nameEn', ''), 100)
        && text(d.get('positionKo', ''), 50) && text(d.get('positionEn', ''), 100)
        && text(d.get('deptKo', ''), 100) && text(d.get('deptEn', ''), 200)
        && text(d.get('researchKo', ''), 200) && text(d.get('researchEn', ''), 300)
        && text(d.get('email', ''), 200)
        // 사진은 관리자 화면에서 줄인 JPEG만
        && (photo == '' || (text(photo, 100000) && photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')));
    }

    match /admins/{email} {
      // 본인 문서는 읽을 수 있어야 관리자인지 확인할 수 있어요
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow create: if isAdmin() && email == email.lower();
      allow delete: if isAdmin() && email != myEmail();
    }

    // 공개 게시판: 누구나 읽고, 관리자만 씀
    match /notices/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }
    match /seminars/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }
    match /news/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }

    // 구성원: 누구나 읽고(구성원 → 참여 연구원), 관리자만 씀
    match /members/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validMember();
      allow delete: if isAdmin();
    }
  }
}
