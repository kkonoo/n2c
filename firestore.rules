rules_version = '2';

// Firebase 콘솔 → Firestore → 규칙에 그대로 붙여 넣어요.
service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() {
      return request.auth.token.email.lower();
    }
    function signedIn() {
      // 성과 입력 링크의 익명 접속에는 이메일이 없어요
      return request.auth != null && request.auth.token.get('email_verified', false) == true;
    }
    // admins/{이메일} 문서가 있으면 관리자
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }

    function validPost() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'category', 'date', 'body', 'links', 'pinned',
                               'speaker', 'affiliation', 'time', 'place', 'updatedAt', 'updatedBy'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.body is string && d.body.size() <= 50000
        && d.pinned is bool
        && d.links is list && d.links.size() <= 10;
    }

    function text(v, max) {
      return v is string && v.size() <= max;
    }
    function validMember() {
      let d = request.resource.data;
      let photo = d.get('photo', '');
      return d.keys().hasOnly(['nameKo', 'nameEn', 'role', 'group', 'groupRole', 'order', 'positionKo', 'positionEn', 'deptKo', 'deptEn',
                               'researchKo', 'researchEn', 'email', 'photo', 'updatedAt', 'updatedBy'])
        && d.nameKo is string && d.nameKo.size() > 0 && d.nameKo.size() <= 50
        && d.role in ['faculty', 'visiting', 'fulltime', 'postdoc', 'researcher', 'student', 'staff']
        // 핵심과제 그룹과 그룹 안 역할 (js/members.js와 같게)
        && d.get('group', '') in ['', 'g1', 'g2', 'g3', 'auto']
        && d.get('groupRole', '') in ['', 'lead', 'co', 'member']
        // 순서: 같은 묶음에서 작은 숫자가 먼저 (없으면 자동)
        && (!('order' in d) || (d.order is int && d.order >= 1 && d.order <= 999))
        && text(d.get('nameEn', ''), 100)
        && text(d.get('positionKo', ''), 50) && text(d.get('positionEn', ''), 100)
        && text(d.get('deptKo', ''), 100) && text(d.get('deptEn', ''), 200)
        && text(d.get('researchKo', ''), 200) && text(d.get('researchEn', ''), 300)
        && text(d.get('email', ''), 200)
        // 사진은 관리자 화면에서 줄인 JPEG만
        && (photo == '' || (text(photo, 100000) && photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')));
    }

    // 공모·신청은 로그인 없이 누구나. 이메일은 신청자가 적은 주소예요
    function validApplication() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'type', 'name', 'dept', 'position', 'phone',
                               'details', 'memo', 'files', 'status', 'createdAt'])
        && d.email is string && d.email.size() <= 200 && d.email.matches('[^@\\s]+@[^@\\s]+[.][^@\\s]+')
        && d.type in ['seed-pi', 'humanities', 'study', 'club',
                      'industry-intern', 'global-training', 'lab-intern', 'workshop']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 50
        && d.dept is string && d.dept.size() > 0 && d.dept.size() <= 100
        && text(d.get('position', ''), 50)
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 30
        && d.details is map && d.details.size() <= 10
        && text(d.get('memo', ''), 2000)
        && d.files is list && d.files.size() <= 5
        && d.status == 'submitted'
        && d.createdAt == request.time;
    }

    // 성과 입력: 교수님별 개인 링크(report.html?k=토큰)를 열면 익명으로 로그인하고
    // reportSessions/{uid}에 토큰을 적어요. 그 토큰(reportKeys/{토큰})의 교수님 실적만 읽고 써요.
    function myReporter() {
      let k = get(/databases/$(database)/documents/reportSessions/$(request.auth.uid)).data.k;
      return get(/databases/$(database)/documents/reportKeys/$(k)).data.prof;
    }
    function isReporter(pid) {
      return request.auth != null && myReporter() == pid;
    }
    function validReport() {
      let d = request.resource.data;
      return d.keys().hasOnly(['prof', 'cat', 'f', 'createdAt', 'updatedAt'])
        && d.prof is string
        // 항목 (js/report-types.js와 같게)
        && d.cat in ['paper', 'patent', 'event', 'people', 'edu', 'collab', 'infra', 'company', 'transfer', 'econ', 'jobs', 'award', 'press']
        && d.f is map && d.f.size() <= 30;
    }

    match /admins/{email} {
      // 본인 문서는 읽을 수 있어야 관리자인지 확인할 수 있어요
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow create: if isAdmin() && email == email.lower();
      allow delete: if isAdmin() && email != myEmail();
    }

    // 공개 게시판: 누구나 읽고, 관리자만 씀
    match /notices/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }
    match /seminars/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }
    match /news/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }

    // 구성원: 누구나 읽고(사업단 소개 → 구성원), 관리자만 씀
    match /members/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validMember();
      allow delete: if isAdmin();
    }

    // 공모·신청: 누구나 새로 내기만 하고, 보는 건 관리자만. 관리자는 결과(상태·메모)만 고쳐요
    match /applications/{id} {
      allow read: if isAdmin();
      allow create: if validApplication();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'decidedAt', 'decidedBy'])
        && request.resource.data.status in ['submitted', 'approved', 'rejected']
        && text(request.resource.data.get('note', ''), 2000);
      allow delete: if isAdmin();
    }

    // 성과 입력: 교수님 명단·토큰은 관리자만 관리해요. 토큰 문서는 그 토큰을 아는 사람만 열 수 있어요(목록은 관리자만)
    match /reporters/{pid} {
      allow read, write: if isAdmin();
    }
    match /reportKeys/{key} {
      allow get: if request.auth != null;
      allow list, write: if isAdmin();
    }
    match /reportSessions/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['k', 'at'])
        && request.resource.data.k is string && request.resource.data.k.matches('[A-Za-z0-9_-]{20,64}')
        && exists(/databases/$(database)/documents/reportKeys/$(request.resource.data.k));
    }
    // 실적: 관리자는 모두, 교수님은 자기 것만. 공개 페이지에는 나오지 않아요
    match /reports/{id} {
      allow read, delete: if isAdmin() || isReporter(resource.data.prof);
      allow create: if validReport() && (isAdmin() || isReporter(request.resource.data.prof));
      allow update: if validReport() && request.resource.data.prof == resource.data.prof
        && (isAdmin() || isReporter(resource.data.prof));
    }
  }
}
